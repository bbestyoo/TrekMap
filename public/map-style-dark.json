{
  "version": 8,
  "name": "Himalaya Dark",
  "metadata": { "description": "Google-Earth-inspired dark satellite style for Himalaya trekking explorer" },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sprite": "https://demotiles.maplibre.org/styles/osm-bright-gl-style/sprite",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 19
    },
    "stamen-terrain": {
      "type": "raster",
      "tiles": [
        "https://stamen-tiles.a.ssl.fastly.net/terrain-background/{z}/{x}/{y}.jpg"
      ],
      "tileSize": 256,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#04080f" }
    }
  ]
}
